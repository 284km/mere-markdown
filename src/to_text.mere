// src/to_text.mere — a document, shown as plain text.
//
// Plain text is the source with its decorations removed, which makes it the
// output that needs the parse least and suffered most without it. It used to
// look at one line at a time and had no idea what a fenced code block was, so it
// stripped the markers out of code — the one place in a document where a `*` is
// not a decoration.
//
// Line for line with the source, still. That is why the document has `Blank`:
// HTML wants nothing to do with blank lines, and this cannot put them back.

import "./parse.mere";

// Drop the inline markers. Top-level and self-recursive, like the finders in
// to_html.mere, because that is the shape this compiler is comfortable with.
let rec __md_strip = fn (s: str) -> fn (i: int) -> fn (acc: str) ->
  if i >= str_len s then acc
  else
    let c = char_at s i in
    if c == "*" || c == "_" || c == "`" then __md_strip s (i + 1) acc
    else __md_strip s (i + 1) (acc ++ c);

module MdText {

let strip_inline = fn (s: str) -> __md_strip s 0 "";

// (depth - 1) levels of two spaces, the indent the source had.
let indent_of = fn (depth: int) ->
  let rec go = fn (d: int) -> fn (acc: str) ->
    if d <= 1 then acc else go (d - 1) (acc ++ "  ")
  in go depth "";

let of_blocks = fn (bs: block list) ->
  region R {
    let b = strbuf_new () in
    let emit = fn (t: str) ->
      let _ = strbuf_push b t in
      let _ = strbuf_push b "\n" in () in
    let _ = list_iter bs (fn blk ->
      match blk with
      | Blank -> emit ""
      | Heading (_lvl, text) -> emit (strip_inline text)
      | Para ls -> list_iter ls (fn l -> emit (strip_inline l))
      // A rule is a rule. The old converter stripped it as if it were emphasis,
      // so `---` survived and `***` came out as an empty line.
      | Hr src -> emit src
      | Quote ts -> list_iter ts (fn t -> emit ("| " ++ strip_inline t))
      | Table rows -> list_iter rows (fn r -> emit (strip_inline r))
      | Bullets items -> list_iter items (fn (it: item) ->
          emit (indent_of it.depth ++ it.marker ++ strip_inline it.text))
      // The fences themselves are markup and go; what is between them is code
      // and is left exactly as written. Stripping a `*` out of a program is the
      // defect this whole repository was opened for.
      | Fence (_lang, body, closed) ->
        let _ = emit "" in
        let _ = list_iter body emit in
        if closed then emit "" else ()) in
    strbuf_to_str b
  };

let render = fn (lines: str list) -> of_blocks (Md.parse lines);

};   // end of `module MdText`
