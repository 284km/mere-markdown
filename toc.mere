// src/toc.mere — a document, shown as its headings.
//
// This is the output the missing parse cost the most. It counted `#` on every
// line it was given, including the lines inside a fenced code block, so a
// document could put `## not a heading` in an example and get it in its table of
// contents while the HTML correctly showed it as code. One line, two answers.
//
// It now reads headings off the document, so there is nothing left to disagree
// with: whatever `parse` calls a heading is what appears here.

import "./parse.mere";

module MdToc {

// The headings, in document order. Returned as data rather than as a rendered
// list, so that a consumer wanting slugs and anchor links builds them from this
// instead of counting hashes for itself and becoming the fifth answer.
let headings = fn (bs: block list) ->
  let rec go = fn (rest: block list) -> fn (acc: (int * str) list) ->
    match rest with
    | Nil -> list_rev acc
    | Cons (b, more) ->
      match b with
      | Heading (d, t) -> go more (Cons ((d, t), acc))
      | _ -> go more acc
  in go bs Nil;

// The indent for depth N: (N-1) copies of "  " followed by "- ".
let make_indent = fn (depth: int) ->
  let rec go = fn (d: int) -> fn (acc: str) ->
    if d <= 1 then acc ++ "- " else go (d - 1) (acc ++ "  ")
  in go depth "";

let of_headings = fn (hs: (int * str) list) ->
  region R {
    let buf = strbuf_new () in
    let _ = list_iter hs (fn h ->
      let (d, t) = h in
      let _ = strbuf_push buf (make_indent d) in
      let _ = strbuf_push buf t in
      let _ = strbuf_push buf "\n" in ()) in
    strbuf_to_str buf
  };

let render = fn (lines: str list) -> of_headings (headings (Md.parse lines));

};   // end of `module MdToc`
